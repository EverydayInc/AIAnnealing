{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://every.day/schemas/annealing-pareto/round-report-v1.json",
  "title": "Annealing round report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "round", "role", "model", "input_hashes", "artifact_hash", "expected_movement", "material_changes", "new_evidence", "open_conditions", "duty_bound_obligations", "recommendation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation_id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 0},
    "role": {"enum": ["principal-a", "principal-b", "coordinator"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "family", "build"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1}
      }
    },
    "input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_movement": {"type": "array", "items": {"enum": ["decision", "boundary", "dependency", "assumption", "evidence", "risk-control", "sequence", "verification"]}},
    "material_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "new_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "duty_bound_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommendation": {"type": "string", "minLength": 1}
  }
}
